# --- Database -------------------------------------------------------------
# Hostinger: hPanel → Databases → MySQL Databases. Copy the credentials here.
DATABASE_URL="mysql://u123456789_store_user:YOUR_PASSWORD@localhost:3306/u123456789_store_db"

# --- Server ---------------------------------------------------------------
# The single Node server (Next.js + Express API) listens on this port.
# Hostinger sets PORT for you in hPanel; the local default is 3000.
PORT=3000

# Absolute origin used by server-side fetches (root layout, /shop page).
# Leave it unset to use http://127.0.0.1:$PORT.
# INTERNAL_API_URL=http://127.0.0.1:3000

# Browser origins allowed by CORS. The bundled frontend and API share one
# origin, so this only matters if you ever move the API to another host.
FRONTEND_URL=https://yourstore.com

# --- Security -------------------------------------------------------------
# AES-256-GCM key protecting payment / SMTP / courier / AI credentials that
# are stored in the database. Minimum 32 characters, generate a unique one
# per store, e.g. `openssl rand -hex 32`.
APP_ENCRYPTION_KEY=replace-with-a-32-character-minimum-secret-key